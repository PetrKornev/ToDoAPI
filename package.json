{
  "name": "ToDoRTK",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:withreg": "vite build --mode withreg",
    "build:redux": "vite build --mode redux",
    "build:rtk": "vite build --mode rtk",
    "predeploy:withreg": "npm run build:withreg",
    "predeploy:redux": "npm run build:redux",
    "predeploy:rtk": "npm run build:rtk",
    "deploy:withreg": "gh-pages -d dist -b ToDoAPIWithReg",
    "deploy:redux": "gh-pages -d dist -b ToDoRedux",
    "deploy:rtk": "gh-pages -d dist -b ToDoRTK"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.9.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "globals": "^16.3.0",
    "vite": "^7.1.2"
  }
}
